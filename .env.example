# ==========================================
# Google Vertex AI / Gemini API Configuration
# ==========================================

# Option A: Google AI Studio API Key (Simplest setup)
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Google Cloud Vertex AI (Enterprise / Cloud Project)
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_PROJECT_ID=your-google-cloud-project-id
VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Veo Video Generation Model
# Supported options: veo-2.0-generate-001, veo-3.1-generate-preview, veo-3.1-generate-001, veo-3.1-fast-generate-preview
VEO_MODEL=veo-2.0-generate-001

# ==========================================
# Optional Integrations
# ==========================================
# Pixabay API for royalty-free music search
PIXABAY_API_KEY=your_pixabay_api_key_here

# NVIDIA NIM API for SDXL image generation (optional)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Frontend dev API URL (when running Express backend separately)
# VITE_API_URL=http://localhost:3001
